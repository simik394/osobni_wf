#!/bin/bash
# Adaptive screenshot recording with activity detection and auto-splitting
# Usage: screenshot-record start|stop|status|active|opened|main|all|convert-all|reconcile

SCREENSHOT_DIR="/home/sim/Videos/Screenshots"
RECORDING_DIR="/home/sim/Videos/OBS"
STILLS_DIR="$RECORDING_DIR/Stills"
INTERVAL_ACTIVE=2   # seconds when active
INTERVAL_IDLE=10    # seconds when idle
IDLE_THRESHOLD=10   # seconds of no activity before going idle
CHUNK_DURATION=900 # 15 minutes in seconds
PIDFILE="/tmp/screenshot-record.pid"
LOCKFILE="/tmp/screenshot-record.lock"
MODE_FILE="/tmp/screenshot-record.mode"
MONITOR_FILE="/tmp/screenshot-record.monitor"
CRF=42               # Quality vs space (dej42)

# Configuration
ENABLE_SOUND="false"
SENSITIVE_APPS="digikam keepassxc bitwarden"

convert_session() {
    local S_DIR="$1"
    local TIMESTAMP=$(basename "$S_DIR")
    local BASE_NAME="screenshots_$TIMESTAMP"
    local OUTPUT_PATH="$RECORDING_DIR/$BASE_NAME.mkv"
    local META_PATH="$RECORDING_DIR/$BASE_NAME.json"
    
    if [ ! -d "$S_DIR" ]; then return; fi
    
    # Ensure we don't process empty dirs
    local FILE_COUNT=$(ls "$S_DIR"/frame_*.jpg 2>/dev/null | wc -l)
    if [ "$FILE_COUNT" -eq 0 ]; then
        rm -rf "$S_DIR"
        return
    fi

    cd "$S_DIR" || return
    local i=0
    echo "[" > combined_metadata.json
    rm -f timestamps.srt windows.srt
    
    # Process files in chronological order
    local first=1
    for f in $(ls -tr frame_*.jpg 2>/dev/null); do
        local BASE="${f%.jpg}"
        local JSON_FILE="${BASE}.json"
        
        # Robust Timestamp Extraction
        local TS=$(echo "$f" | grep -oP '\d{10}')
        [ -z "$TS" ] && TS=$(stat -c %Y "$f")
        local DATE_STR=$(date -d "@$TS" "+%H:%M:%S")
        
        local H=$((i / 3600)); local M=$(((i % 3600) / 60)); local S=$((i % 60))
        local H2=$(((i+1) / 3600)); local M2=$((((i+1) % 3600) / 60)); local S2=$(((i+1) % 60))
        
        # Subtitles (Time)
        printf "%d\n%02d:%02d:%02d,000 --> %02d:%02d:%02d,000\n%s\n\n" \
            $((i+1)) $H $M $S $H2 $M2 $S2 "$DATE_STR" >> timestamps.srt
        
        local WIN_TITLE="Unknown"
        if [ -f "$JSON_FILE" ]; then
            WIN_TITLE=$(grep -oP '"active":true,"title":"\K[^"]+' "$JSON_FILE" | head -n 1)
            if [ "$WIN_TITLE" == "Unknown" ] || [ -z "$WIN_TITLE" ]; then
                WIN_TITLE=$(grep -oP '"title":"\K[^"]+' "$JSON_FILE" | grep -v "Unknown" | head -n 1)
            fi
            [ $first -eq 0 ] && echo "," >> combined_metadata.json
            cat "$JSON_FILE" >> combined_metadata.json
            first=0
        fi
        [ -z "$WIN_TITLE" ] && WIN_TITLE="Unknown"
        # Subtitles (Window)
        printf "%d\n%02d:%02d:%02d,000 --> %02d:%02d:%02d,000\n%s\n\n" \
            $((i+1)) $H $M $S $H2 $M2 $S2 "$WIN_TITLE" >> windows.srt
        
        mv "$f" "seq_$(printf '%05d' $i).jpg" 2>/dev/null
        i=$((i + 1))
    done
    echo "]" >> combined_metadata.json
    cd - > /dev/null
    
    local COUNT=$(ls "$S_DIR"/seq_* 2>/dev/null | wc -l)
    local CONV_LOG="/tmp/screenshot-ffmpeg-$TIMESTAMP.log"
    
    if [ "$COUNT" -eq 1 ]; then
        # Handle Single Frame as Still
        mkdir -p "$STILLS_DIR"
        mv "$S_DIR/seq_00000.jpg" "$STILLS_DIR/$BASE_NAME.jpg"
        [ -f "$S_DIR/combined_metadata.json" ] && mv "$S_DIR/combined_metadata.json" "$STILLS_DIR/$BASE_NAME.json"
        echo "Success: Still frame $BASE_NAME.jpg created."
        rm -rf "$S_DIR"
    elif [ "$COUNT" -gt 1 ]; then
        # Handle Session as Video
        /usr/lib/jellyfin-ffmpeg/ffmpeg -y -framerate 1 -i "$S_DIR/seq_%05d.jpg" \
          -attach "$S_DIR/combined_metadata.json" -metadata:s:t mimetype=application/json \
          -c:v libx264 -crf $CRF -g 60 -preset slower -tune stillimage \
          -vf "scale=1200:-2,subtitles=$S_DIR/timestamps.srt:force_style='FontSize=18,Alignment=3,MarginR=15,MarginB=15',subtitles=$S_DIR/windows.srt:force_style='FontSize=16,Alignment=6,MarginV=15'" \
          -pix_fmt yuv420p "$OUTPUT_PATH" > "$CONV_LOG" 2>&1
        
        if [ $? -eq 0 ] && [ -f "$OUTPUT_PATH" ]; then
            if [ -f "$S_DIR/combined_metadata.json" ]; then
                mv "$S_DIR/combined_metadata.json" "$META_PATH"
            fi
            echo "Success: $BASE_NAME.mkv and .json created."
            rm -rf "$S_DIR"
            rm -f "$CONV_LOG"
        else
            echo "FFmpeg failed for $S_DIR. See $CONV_LOG"
        fi
    else
        rm -rf "$S_DIR"
    fi
}
export -f convert_session
export RECORDING_DIR SCREENSHOT_DIR STILLS_DIR CRF

reconcile_orphans() {
    echo "Running reconciliation..."
    # 1. Standardize legacy JSONs in OBS
    for f in "$RECORDING_DIR"/*.json; do
        [ ! -f "$f" ] && continue
        BN=$(basename "$f")
        if [[ ! "$BN" =~ ^screenshots_ ]]; then
            echo "Standardizing legacy metadata: $BN"
            mv "$f" "$RECORDING_DIR/screenshots_$BN"
        fi
    done

    # 2. Check for missing metadata for MKVs
    for f in "$RECORDING_DIR"/*.mkv; do
        [ ! -f "$f" ] && continue
        JSON="${f%.mkv}.json"
        if [ ! -f "$JSON" ]; then
            echo "Warning: Missing metadata file for $(basename "$f")"
            # Try to extract from attachment if ffmpeg allows
            /usr/lib/jellyfin-ffmpeg/ffmpeg -dump_attachment:t combined_metadata.json -i "$f" -y >/dev/null 2>&1
            if [ -f "combined_metadata.json" ]; then
                mv "combined_metadata.json" "$JSON"
                echo "Restored metadata from MKV attachment."
            fi
        fi
    done
}

run_internal() {
    # Self-healing Lock cleanup
    if [ -f "$PIDFILE" ]; then
        OLD_PID=$(cat "$PIDFILE")
        if ! kill -0 "$OLD_PID" 2>/dev/null; then
            echo "Removing stale pidfile: $PIDFILE"
            rm -f "$PIDFILE" "$LOCKFILE"
        fi
    fi

    # Strong double-instance check
    exec 9>"$LOCKFILE"
    if ! flock -n 9; then echo "Another instance is running."; exit 1; fi

    # Auto-detect XAUTHORITY
    if [ -z "$XAUTHORITY" ] && [ -f "/run/user/$(id -u)/gdm/Xauthority" ]; then
        export XAUTHORITY="/run/user/$(id -u)/gdm/Xauthority"
    fi

    # Trap for graceful shutdown
    trap 'echo "Stopping..."; exit 0' SIGINT SIGTERM

    START_TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
    SESSION_DIR="$SCREENSHOT_DIR/$START_TIMESTAMP"
    mkdir -p "$SESSION_DIR"
    echo "$SESSION_DIR" > /tmp/screenshot-session.txt
    
    COUNT=0
    CHUNK_START=$(date +%s)
    CURRENT_SESSION_DIR="$SESSION_DIR"
    CURRENT_IDLE_INTERVAL=$INTERVAL_IDLE
    LAST_SCREENSHOT_TIME=0

    while true; do
        NOW=$(date +%s)
        ELAPSED_CHUNK=$((NOW - CHUNK_START))
        if [ $ELAPSED_CHUNK -ge $CHUNK_DURATION ]; then
            OLD_SESSION_DIR="$CURRENT_SESSION_DIR"
            NEW_TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
            CURRENT_SESSION_DIR="$SCREENSHOT_DIR/$NEW_TIMESTAMP"
            mkdir -p "$CURRENT_SESSION_DIR"
            COUNT=0
            CHUNK_START=$NOW
            echo "$CURRENT_SESSION_DIR" > /tmp/screenshot-session.txt
            
            # Autonomous maintenance: Convert old session + reconcile
            ( convert_session "$OLD_SESSION_DIR" && reconcile_orphans ) &
        fi
        
        # Privacy Check: Skip if sensitive apps are running
        # Efficient combined pgrep check
        SENSITIVE_PATTERN=$(echo $SENSITIVE_APPS | sed 's/ /|/g')
        if pgrep -x "$SENSITIVE_PATTERN" >/dev/null; then
            sleep 10
            continue
        fi

        # Check Display
        if ! xdpyinfo -display :1 >/dev/null 2>&1; then
            echo "$(date): Display :1 not available" >> /tmp/screenshot-error.log
            sleep 30
            continue
        fi

        IDLE_MS=$(gdbus call --session --dest org.gnome.Mutter.IdleMonitor --object-path /org/gnome/Mutter/IdleMonitor/Core --method org.gnome.Mutter.IdleMonitor.GetIdletime 2>/dev/null | awk '{print $2}' | tr -d ',)')
        [ -z "$IDLE_MS" ] && IDLE_MS=0
        
        if [ "$IDLE_MS" -lt "$((IDLE_THRESHOLD * 1000))" ]; then
            INTERVAL=$INTERVAL_ACTIVE
            CURRENT_IDLE_INTERVAL=$INTERVAL_IDLE
        else
            INTERVAL=$CURRENT_IDLE_INTERVAL
        fi

        if [ $((NOW - LAST_SCREENSHOT_TIME)) -ge $INTERVAL ]; then
            export DISPLAY=:1
            TIMESTAMP=$(date +%s)
            
            # Efficient Window Metadata Capture (Pre-Capture for Privacy)
            WINDOW_DATA=$(timeout 2 /home/sim/bin/xmeta 2>/dev/null || echo '{"error":"timeout"}')
            
            # Incognito / Private Window Detection
            if echo "$WINDOW_DATA" | grep -iqE "incognito|inprivate|private browsing|soukromé|anonymní"; then
                LAST_SCREENSHOT_TIME=$NOW
                continue
            fi

            OUTPUT_FILE="$CURRENT_SESSION_DIR/frame_$(printf '%05d' $COUNT)_${TIMESTAMP}.jpg"
            METADATA_FILE="${OUTPUT_FILE%.jpg}.json"
            
            # Monitor selection logic
            MON_MODE=$(cat "$MONITOR_FILE" 2>/dev/null || echo "all")
            SCROT_OPTS="--quality 80"
            [ "$MON_MODE" = "main" ] && SCROT_OPTS="$SCROT_OPTS --autoselect 0,0,2560,1600"

            if scrot $SCROT_OPTS "$OUTPUT_FILE" 2>>/tmp/screenshot-error.log; then
                TOP_PROC=$(ps -eo comm,pcpu,pmem --sort=-pcpu --no-headers | head -n 5 | awk '{printf "{\"name\":\"%s\",\"cpu\":\"%s\",\"mem\":\"%s\"},", $1, $2, $3}' | sed 's/,$//')
                echo "{\"timestamp\":$TIMESTAMP,\"active_window\":$WINDOW_DATA,\"top_processes\":[$TOP_PROC]}" > "$METADATA_FILE"
                
                COUNT=$((COUNT + 1))
                LAST_SCREENSHOT_TIME=$NOW
                
                if [ "$IDLE_MS" -ge "$((IDLE_THRESHOLD * 1000))" ]; then
                    CURRENT_IDLE_INTERVAL=$((CURRENT_IDLE_INTERVAL * 2))
                    [ $CURRENT_IDLE_INTERVAL -gt 3600 ] && CURRENT_IDLE_INTERVAL=3600
                fi
            fi
        fi
        sleep 1
    done
}

case "$1" in
  run-internal) run_internal ;;
  info)
    echo "╔══════════════════════════════════════════╗"
    echo "║     Screenshot-Record Service Status     ║"
    echo "╠══════════════════════════════════════════╣"
    
    # Service & Process status
    SVC_STATE=$(systemctl --user is-active screenshot-record.service 2>/dev/null || echo "not-installed")
    PID=$(cat "$PIDFILE" 2>/dev/null)
    
    if [ "$SVC_STATE" = "active" ]; then
        # Get uptime from systemd
        SINCE=$(systemctl --user show screenshot-record.service --property=ActiveEnterTimestamp 2>/dev/null | cut -d= -f2)
        if [ -n "$SINCE" ]; then
            SINCE_EPOCH=$(date -d "$SINCE" +%s 2>/dev/null)
            NOW_EPOCH=$(date +%s)
            UPTIME_SECS=$((NOW_EPOCH - SINCE_EPOCH))
            UPTIME_H=$((UPTIME_SECS / 3600))
            UPTIME_M=$(((UPTIME_SECS % 3600) / 60))
            echo "║ Status:  🟢 RUNNING (uptime: ${UPTIME_H}h ${UPTIME_M}m)"
        else
            echo "║ Status:  🟢 RUNNING"
        fi
    elif [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "║ Status:  🟡 STANDALONE (PID: $PID)"
    else
        echo "║ Status:  🔴 STOPPED"
    fi
    
    # Active session info
    SESSION_DIR=$(cat /tmp/screenshot-session.txt 2>/dev/null)
    if [ -n "$SESSION_DIR" ] && [ -d "$SESSION_DIR" ]; then
        FRAME_COUNT=$(find "$SESSION_DIR" -name "frame_*.jpg" 2>/dev/null | wc -l)
        SESSION_NAME=$(basename "$SESSION_DIR")
        echo "║ Session: $SESSION_NAME ($FRAME_COUNT frames)"
        
        # Calculate capture rate
        if [ "$FRAME_COUNT" -gt 1 ]; then
            FIRST_FRAME=$(ls -t "$SESSION_DIR"/frame_*.jpg 2>/dev/null | tail -1)
            LAST_FRAME=$(ls -t "$SESSION_DIR"/frame_*.jpg 2>/dev/null | head -1)
            if [ -n "$FIRST_FRAME" ] && [ -n "$LAST_FRAME" ]; then
                T1=$(stat -c %Y "$FIRST_FRAME")
                T2=$(stat -c %Y "$LAST_FRAME")
                SPAN=$((T2 - T1))
                if [ "$SPAN" -gt 0 ]; then
                    RATE=$(echo "scale=1; $FRAME_COUNT * 60 / $SPAN" | bc 2>/dev/null)
                    echo "║ Rate:    ~${RATE} frames/min"
                fi
            fi
        fi
    fi
    
    # Privacy check
    BLOCKED=""
    for app in $SENSITIVE_APPS; do
        if pgrep -x "$app" >/dev/null 2>&1; then
            BLOCKED="$BLOCKED $app"
        fi
    done
    if [ -n "$BLOCKED" ]; then
        echo "║ Privacy: 🔒 PAUSED (${BLOCKED# })"
    fi
    
    echo "╠══════════════════════════════════════════╣"
    echo "║              Data Summary                ║"
    echo "╠══════════════════════════════════════════╣"
    
    # Backlog
    BACKLOG_COUNT=$(find "$SCREENSHOT_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
    BACKLOG_SIZE=$(du -sh "$SCREENSHOT_DIR" 2>/dev/null | cut -f1)
    echo "║ Backlog: $BACKLOG_COUNT sessions ($BACKLOG_SIZE)"
    
    # Archives
    VIDEO_COUNT=$(find "$RECORDING_DIR" -maxdepth 1 -name "*.mkv" 2>/dev/null | wc -l)
    JSON_COUNT=$(find "$RECORDING_DIR" -maxdepth 1 -name "*.json" 2>/dev/null | wc -l)
    STILL_COUNT=$(find "$STILLS_DIR" -maxdepth 1 -name "*.jpg" 2>/dev/null | wc -l)
    ARCHIVE_SIZE=$(du -sh "$RECORDING_DIR" 2>/dev/null | cut -f1)
    
    echo "║ Videos:  $VIDEO_COUNT archived ($ARCHIVE_SIZE)"
    echo "║ JSONs:   $JSON_COUNT metadata files"
    echo "║ Stills:  $STILL_COUNT single-frame captures"
    
    # Metadata parity check
    ORPHAN_VIDEOS=0
    for f in "$RECORDING_DIR"/*.mkv; do
        [ ! -f "$f" ] && continue
        [ ! -f "${f%.mkv}.json" ] && ORPHAN_VIDEOS=$((ORPHAN_VIDEOS + 1))
    done
    if [ "$ORPHAN_VIDEOS" -gt 0 ]; then
        echo "║ ⚠️  $ORPHAN_VIDEOS videos missing JSON metadata"
    else
        echo "║ ✅ All videos have paired metadata"
    fi
    
    echo "╠══════════════════════════════════════════╣"
    echo "║            Historical Stats              ║"
    echo "╠══════════════════════════════════════════╣"
    
    # Time coverage: oldest and newest recording (only screenshots_* files)
    OLDEST=$(ls "$RECORDING_DIR"/screenshots_*.mkv 2>/dev/null | head -1)
    NEWEST=$(ls "$RECORDING_DIR"/screenshots_*.mkv 2>/dev/null | tail -1)
    if [ -n "$OLDEST" ] && [ -n "$NEWEST" ]; then
        OLDEST_NAME=$(basename "$OLDEST" | sed 's/screenshots_//;s/\.mkv//')
        NEWEST_NAME=$(basename "$NEWEST" | sed 's/screenshots_//;s/\.mkv//')
        echo "║ First:   $OLDEST_NAME"
        echo "║ Latest:  $NEWEST_NAME"
        
        # Calculate total days covered
        OLDEST_DATE=$(echo "$OLDEST_NAME" | cut -d_ -f1)
        NEWEST_DATE=$(echo "$NEWEST_NAME" | cut -d_ -f1)
        if [ -n "$OLDEST_DATE" ] && [ -n "$NEWEST_DATE" ]; then
            D1=$(date -d "$OLDEST_DATE" +%s 2>/dev/null)
            D2=$(date -d "$NEWEST_DATE" +%s 2>/dev/null)
            if [ -n "$D1" ] && [ -n "$D2" ]; then
                DAYS=$(( (D2 - D1) / 86400 ))
                echo "║ Span:    $DAYS days of coverage"
                if [ "$DAYS" -gt 0 ] && [ "$VIDEO_COUNT" -gt 0 ]; then
                    AVG=$(echo "scale=1; $VIDEO_COUNT / $DAYS" | bc 2>/dev/null)
                    echo "║ Avg:     ~$AVG videos/day"
                fi
            fi
        fi
    fi
    
    # Today's activity
    TODAY=$(date +%Y-%m-%d)
    TODAY_COUNT=$(find "$RECORDING_DIR" -maxdepth 1 -name "screenshots_${TODAY}*.mkv" 2>/dev/null | wc -l)
    echo "║ Today:   $TODAY_COUNT videos recorded"
    
    echo "╚══════════════════════════════════════════╝"
    ;;
  start)
    # CLI entry point: always delegates to systemd if available
    if systemctl --user cat screenshot-record.service >/dev/null 2>&1; then
        systemctl --user start screenshot-record.service
        sleep 1
        systemctl --user status screenshot-record.service --no-pager
    else
        # Fallback for systems without the unit file
        if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then echo "Already running."; exit 0; fi
        [ -z "$DISPLAY" ] && export DISPLAY=:1
        setsid "$0" run-internal >>/tmp/screenshot-record.log 2>&1 &
        PID=$!
        echo $PID > "$PIDFILE"
        echo "Recording started standalone (PID: $PID)"
    fi
    ;;
  stop)
    if systemctl --user is-active screenshot-record.service >/dev/null 2>&1; then
        systemctl --user stop screenshot-record.service
        echo "Service stopped."
    else
        PID=$(cat "$PIDFILE" 2>/dev/null)
        [ -z "$PID" ] && PID=$(pgrep -f "$(basename "$0") run-internal")
        if [ -n "$PID" ]; then
            kill "$PID" 2>/dev/null
            rm -f "$PIDFILE" "$LOCKFILE"
            echo "Standalone instance stopped."
        else
            echo "Not running."
        fi
    fi
    ;;
  convert-current)
    # Called by ExecStopPost to finalize the current session
    SESSION_DIR=$(cat /tmp/screenshot-session.txt 2>/dev/null)
    if [ -n "$SESSION_DIR" ] && [ -d "$SESSION_DIR" ]; then
        convert_session "$SESSION_DIR"
    fi
    rm -f /tmp/screenshot-session.txt "$PIDFILE" "$LOCKFILE"
    ;;
  status)
    SVC_STATE=$(systemctl --user is-active screenshot-record.service 2>/dev/null || echo "unknown")
    PID=$(cat "$PIDFILE" 2>/dev/null)
    if [ "$SVC_STATE" = "active" ]; then
        echo "Running (systemd, PID: $(systemctl --user show screenshot-record.service -p MainPID --value 2>/dev/null))"
    elif [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        echo "Running standalone (PID: $PID)"
    else
        echo "Stopped"
    fi
    ;;
  convert-all)
    ACTIVE_SESSION=$(cat /tmp/screenshot-session.txt 2>/dev/null)
    echo "Converting all historical sessions..."
    for dir in "$SCREENSHOT_DIR"/*/; do
        dir="${dir%/}"
        if [ "$dir" != "$ACTIVE_SESSION" ] && [ -d "$dir" ]; then
            echo "Processing $(basename "$dir")..."
            convert_session "$dir"
        fi
    done
    echo "Done."
    ;;
  reconcile) reconcile_orphans ;;
  *) echo "Usage: $0 {start|stop|status|info|convert-all|convert-current|reconcile}"; exit 1 ;;
esac
