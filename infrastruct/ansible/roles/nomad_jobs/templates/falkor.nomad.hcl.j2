job "falkor" {
  datacenters = ["{{ nomad_datacenter | default("oci-eu") }}"]
  type        = "service"

  group "server" {
    count = 1

    network {
      mode = "bridge"
      port "db" {
        static = 6379
        to     = 6379
      }
      port "ui" {
        static = 3005
        to     = 3000
      }
    }

    constraint {
      attribute = "${node.class}"
      value     = "cloud"
    }

    task "falkor" {
      driver = "docker"

      config {
        image = "falkordb/falkordb:latest"
        ports = ["db", "ui"]
        args = [
          "--save", "60", "1",
          "--loglevel", "notice"
        ]
        mounts = [
            {
                type     = "bind"
                target   = "/data"
                source   = "/opt/falkor/data"
                readonly = false
            }
        ]
      }

      resources {
        cpu    = 500
        memory = 1024
      }

      service {
        name = "falkor"
        port = "db"
        tags = [
          "falkor",
          "db",
          "traefik.enable=false"
        ]

        check {
          name     = "redis-alive"
          type     = "tcp"
          interval = "10s"
          timeout  = "2s"
        }
      }

      service {
        name = "falkor-ui"
        port = "ui"
        tags = [
          "traefik.enable=true",
          "traefik.http.routers.falkor-ui.rule=Host(`falkor.130.61.225.114.nip.io`)",
          "traefik.http.routers.falkor-ui.entrypoints=websecure",
          "traefik.http.routers.falkor-ui.tls.certresolver=letsencrypt",
          "traefik.http.services.falkor-ui.loadbalancer.server.port=3000"
        ]
      }
    }
  }
}
