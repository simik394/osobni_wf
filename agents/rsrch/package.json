{
  "name": "rsrch",
  "version": "1.0.35",
  "description": "Automated researcher agent using Perplexity AI and Gemini",
  "main": "src/cli.ts",
  "bin": {
    "rsrch": "dist/cli/main.js"
  },
  "scripts": {
    "rsrch": "ts-node src/cli/main.ts",
    "auth": "ts-node src/cli/main.ts auth",
    "login": "HEADLESS=false ts-node src/cli.ts login",
    "start": "node dist/cli.js",
    "serve": "ts-node src/server.ts",
    "debug:notebook": "ts-node src/debug-notebooklm.ts",
    "build": "tsc -p tsconfig.json && cp src/selectors.yaml dist/",
    "test": "vitest run --reporter=json --outputFile=../../_artifacts/reports/rsrch/test-results.json",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run 'tests/e2e/**'",
    "docs:api": "ts-node scripts/generate_api_docs.ts > docs/API_REFERENCE.qmd",
    "docs:cli": "ts-node scripts/generate_cli_docs.ts > docs/CLI_REFERENCE.qmd",
    "docs:config": "ts-node scripts/generate_config_docs.ts > docs/CONFIG_REFERENCE.qmd",
    "docs:arch": "ts-node scripts/generate_architecture.ts > docs/ARCHITECTURE.qmd",
    "docs:render": "cd docs && quarto render index.qmd && quarto render API_REFERENCE.qmd && quarto render CLI_REFERENCE.qmd && quarto render CONFIG_REFERENCE.qmd && quarto render ARCHITECTURE.qmd",
    "docs:all": "npm run docs:api && npm run docs:cli && npm run docs:config && npm run docs:arch && npm run docs:render",
    "report:test": "ts-node scripts/generate_test_report.ts > ../../_artifacts/reports/rsrch/TEST_REPORT.qmd && quarto render ../../_artifacts/reports/rsrch/TEST_REPORT.qmd"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@agents/shared": "file:../shared",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "falkordb": "^6.5.1",
    "fengari": "^0.1.5",
    "fengari-interop": "^0.1.4",
    "ioredis": "^5.9.2",
    "js-yaml": "^4.1.1",
    "langfuse": "^3.38.6",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^13.0.0",
    "wasmoon": "^1.16.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.28",
    "@vitest/ui": "^1.6.0",
    "msw": "^2.2.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
