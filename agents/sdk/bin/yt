#!/usr/bin/env node

const { Command } = require('commander');
const { McpBridge } = require('../src/mcp-bridge');
const picocolors = require('picocolors');

const program = new Command();
const bridge = new McpBridge();

program
  .name('yt')
  .description('Agentic SDK YouTrack CLI')
  .version('1.0.0');

// Helper to handle async actions
const wrap = (fn) => async (...args) => {
    try {
        await fn(...args);
    } catch (err) {
        console.error(picocolors.red(`Error: ${err.message}`));
        process.exit(1);
    }
};

program
  .command('list')
  .description('List unresolved issues in YouTrack')
  .option('-p, --project <project>', 'Project key')
  .action(wrap(async (options) => {
      let query = '#Unresolved';
      if (options.project) {
          query = `project: ${options.project} and #Unresolved`;
      }
      
      console.log(picocolors.cyan(`Searching issues: ${query}...`));
      const response = await bridge.callTool('napovedayt', 'search_issues', { query });
      
      const issues = response.issuesPage || [];
      
      if (!issues || issues.length === 0) {
          console.log(picocolors.yellow('No issues found.'));
          return;
      }

      console.log(picocolors.green(`\nFound ${issues.length} issues:`));
      issues.forEach(issue => {
          console.log(`${picocolors.bold(issue.id)}: ${issue.summary} [${issue.customFields?.State || 'N/A'}]`);
      });
  }));

program
  .command('get <issueId>')
  .description('Get detailed information for a specific issue')
  .action(wrap(async (issueId) => {
      console.log(picocolors.cyan(`Fetching ${issueId}...`));
      const issue = await bridge.callTool('napovedayt', 'get_issue', { issueId });
      
      console.log(picocolors.green(`\n--- ${issue.id}: ${issue.summary} ---`));
      console.log(picocolors.white(issue.description || 'No description provided.'));
      console.log(picocolors.blue(`\nState: ${issue.customFields?.State || 'N/A'}`));
      console.log(picocolors.blue(`Assignee: ${issue.customFields?.Assignee || 'Unassigned'}`));
  }));

program
  .command('comment <issueId> <text>')
  .description('Add a comment to an issue')
  .action(wrap(async (issueId, text) => {
      console.log(picocolors.cyan(`Adding comment to ${issueId}...`));
      await bridge.callTool('napovedayt', 'add_issue_comment', { issueId, text });
      console.log(picocolors.green('Comment added successfully.'));
  }));

program
  .command('create')
  .description('Create a new issue')
  .requiredOption('-s, --summary <summary>', 'Issue summary')
  .requiredOption('-d, --description <description>', 'Issue description')
  .requiredOption('-p, --project <project>', 'Project key')
  .action(wrap(async (options) => {
      console.log(picocolors.cyan(`Creating issue in ${options.project}...`));
      const issue = await bridge.callTool('napovedayt', 'create_issue', {
          project: options.project,
          summary: options.summary,
          description: options.description
      });
      console.log(picocolors.green(`Issue created: ${issue.id}`));
  }));

program
  .command('report-lean <issueId> <filePath>')
  .description('Run Lean 4 proof and report results to YouTrack')
  .action(wrap(async (issueId, filePath) => {
      const fs = require('fs-extra');
      const { execSync } = require('child_process');
      const path = require('path');

      if (!await fs.pathExists(filePath)) {
          throw new Error(`File not found: ${filePath}`);
      }

      console.log(picocolors.cyan(`Executing Lean 4 on ${filePath}...`));
      
      let leanOutput;
      let success = true;
      try {
          leanOutput = execSync(`lean ${filePath}`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
      } catch (err) {
          success = false;
          leanOutput = err.stdout + err.stderr;
      }

      const content = await fs.readFile(filePath, 'utf8');
      const report = [
          `## 🛡️ Lean 4 Design Critique: \`${path.basename(filePath)}\``,
          `**Status**: ${success ? '✅ Verified' : '❌ Issues Found'}`,
          '',
          '### 📝 Formal Model',
          '```lean',
          content,
          '```',
          '',
          '### 🔍 Analysis Output',
          '```text',
          leanOutput || (success ? 'No errors.' : 'Unknown error.'),
          '```',
          '',
          `*Generated automatically by Jules VM Opponent suite.*`
      ].join('\n');

      console.log(picocolors.cyan(`Posting report to ${issueId}...`));
      await bridge.callTool('napovedayt', 'add_issue_comment', { issueId, text: report });
      console.log(picocolors.green('Report posted successfully to YouTrack.'));
  }));

program.parse(process.argv);
